theme "Extreme Layout Neon" {
  variables {
    --spm-bg-primary: "#090a0f";
    --spm-bg-surface: "#12151e";
    --spm-bg-element: "#1c202e";
    --spm-text-primary: "#ffffff";
    --spm-text-muted: "#a0a5b5";
    --spm-accent: "#ff0055";
    --spm-border-contrast: "rgba(255, 0, 85, 0.2)";
    --spm-radius: "12px";
  }

  customStyles {
    "#inline-stress-container { width: 100% !important; margin: 0 !important; float: none !important; }"
    ":host { display: block; width: 100%; box-sizing: border-box; }"
  }
}

reconstruct "#section-1" -> UiModernGridPage {
  pageTitle: "Extreme Layout & Shadow DOM Gallery";
  sidebarWidth: "280px";

  child items {
    selector: "#inline-stress-container, #negative-margin-container";
    bind title: "self | text";
    bind imageUrl: "img | attr:src";
    bind linkUrl: "a | attr:href";
    bind id: "self | attr:id";
  }

  preserve {
    shadowDomHost: "#shadow-host";
  }
}

selector "header" -> UiNavHeader {
  action: replace;
  siteName: "Layout Sandbox";
  sticky: true;
  primaryLinks: [
    { "label": "Gallery", "url": "/gallery" },
    { "label": "Mutations", "url": "/mutations" },
    { "label": "Shadow DOM", "url": "/shadow" }
  ];
}

selector "#negative-margin-container" {
  action: hide;
}
