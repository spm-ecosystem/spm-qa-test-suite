{
    "components": [
        {
            "action": "replace",
            "name": "UiNavHeader",
            "props": {
                "primaryLinks": [
                    {
                        "label": "Gallery",
                        "url": "/gallery"
                    },
                    {
                        "label": "Mutations",
                        "url": "/mutations"
                    },
                    {
                        "label": "Shadow DOM",
                        "url": "/shadow"
                    }
                ],
                "siteName": "Layout Sandbox",
                "sticky": true
            },
            "selector": "header"
        },
        {
            "action": "hide",
            "selector": "#negative-margin-container"
        }
    ],
    "reconstructs": [
        {
            "children": [
                {
                    "name": "items",
                    "propsMap": {
                        "id": "self | attr:id",
                        "imageUrl": "img | attr:src",
                        "linkUrl": "a | attr:href",
                        "title": "self | text"
                    },
                    "selector": "#inline-stress-container, #negative-margin-container"
                }
            ],
            "containerSelector": "#section-1",
            "layoutComponent": "UiModernGridPage",
            "preserve": {
                "shadowDomHost": "#shadow-host"
            },
            "props": {
                "pageTitle": "Extreme Layout & Shadow DOM Gallery",
                "sidebarWidth": "280px"
            }
        }
    ],
    "theme": {
        "cssVariables": {
            "--spm-accent": "#ff0055",
            "--spm-bg-element": "#1c202e",
            "--spm-bg-primary": "#090a0f",
            "--spm-bg-surface": "#12151e",
            "--spm-border-contrast": "rgba(255, 0, 85, 0.2)",
            "--spm-radius": "12px",
            "--spm-text-muted": "#a0a5b5",
            "--spm-text-primary": "#ffffff"
        },
        "customStyles": "#inline-stress-container { width: 100% !important; margin: 0 !important; float: none !important; }\n:host { display: block; width: 100%; box-sizing: border-box; }",
        "label": "Extreme Layout Neon"
    }
}
