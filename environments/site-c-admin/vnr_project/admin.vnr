theme "Dark Modern Algolia Admin" {
  variables {
    --spm-bg-primary: "#09090b";
    --spm-bg-surface: "#121215";
    --spm-bg-element: "#18181b";
    --spm-text-primary: "#f4f4f5";
    --spm-text-muted: "#a1a1aa";
    --spm-accent: "#ff6600";
    --spm-border-contrast: "rgba(255, 255, 255, 0.08)";
  }

  customStyles {
    "body { background-color: #09090b !important; color: #f4f4f5 !important; font-family: 'Inter', sans-serif !important; }"
  }
}

class HnStoryItem {
  bind title: ".Story_title a | text";
  bind url: ".Story_title a | attr:href";
  bind points: ".Story_meta span | text";
  bind author: "a.hnuser | text";
}

class MetricRowItem {
  bind metricName: "td:nth-child(1) | text";
  bind metricValue: "td:nth-child(2) | text";
  bind status: "td:nth-child(3) span | text";
}

reconstruct ".SearchResults_container" -> UiTableListPage {
  pageTitle: "Hacker News Search Results";
  height: "calc(100vh - 120px)";

  infiniteScroll: R"({
    "nextPageSelector": ".ais-Pagination-item--next a",
    "nextPageText": ">"
  })";

  preserve {
    preservedCards: ".Story_container";
  }

  child searchResults extends HnStoryItem {
    selector: ".Story_container";
  }
}

reconstruct "#admin-dashboard-container" -> UiStatsDashboard {
  pageTitle: "System Performance Metrics";
  
  preserve {
    chartCanvas: "#metrics-chart";
  }
}

reconstruct "#legacy-metrics-table" -> UiTableListPage {
  pageTitle: "Metrics Audit Table";
  height: "calc(100vh - 100px)";

  child tableRows extends MetricRowItem {
    selector: "tbody tr";
  }
}
