{
    "components": [
        {
            "action": "replace",
            "name": "UiNavHeader",
            "props": {
                "logoUrl": "https://synthetic-legacy-portal.internal/assets/logo.png",
                "primaryLinks": [
                    {
                        "label": "Catalog",
                        "url": "/catalog"
                    },
                    {
                        "label": "Archive",
                        "url": "/archive"
                    },
                    {
                        "label": "Help & Docs",
                        "url": "/docs"
                    }
                ],
                "siteName": "Legacy Portal Sandbox"
            },
            "selector": "header"
        },
        {
            "action": "hide",
            "selector": "#section-3-deprecated-tags marquee, #search-form-footer, center > font"
        }
    ],
    "reconstructs": [
        {
            "children": [
                {
                    "name": "tableRows",
                    "propsMap": {
                        "detail": "td:last-child | html",
                        "title": "td:first-child | text"
                    },
                    "selector": "table table tr"
                }
            ],
            "containerSelector": "#section-1-deep-tables",
            "layoutComponent": "UiTableListPage",
            "preserve": {
                "hiddenMetadata": "#search-form-secondary input[type='hidden']",
                "legacySearchForm": "#search-form-primary"
            },
            "props": {
                "columns": [
                    {
                        "header": "Item / Level",
                        "key": "title",
                        "type": "text"
                    },
                    {
                        "header": "Cell Content",
                        "key": "detail",
                        "type": "html"
                    }
                ],
                "pageTitle": "Modernized Legacy Data Catalog"
            }
        }
    ],
    "theme": {
        "cssVariables": {
            "--spm-accent": "#58a6ff",
            "--spm-bg-element": "#21262d",
            "--spm-bg-primary": "#0d1117",
            "--spm-bg-surface": "#161b22",
            "--spm-border-contrast": "rgba(240, 246, 252, 0.1)",
            "--spm-text-muted": "#8b949e",
            "--spm-text-primary": "#c9d1d9"
        },
        "customStyles": "marquee { display: none !important; } font { color: inherit !important; font-family: inherit !important; }",
        "label": "Extreme Legacy Dark"
    }
}
