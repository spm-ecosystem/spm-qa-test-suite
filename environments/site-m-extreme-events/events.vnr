theme "Event Sandbox Cyber" {
  variables {
    --spm-bg-primary: "#050505";
    --spm-bg-surface: "#121212";
    --spm-bg-element: "#1e1e1e";
    --spm-text-primary: "#00ff66";
    --spm-text-muted: "#888888";
    --spm-accent: "#00e5ff";
    --spm-border-contrast: "rgba(0, 255, 102, 0.2)";
  }

  customStyles {
    "#qa-log { font-family: monospace !important; border: 1px solid var(--spm-accent) !important; }"
  }
}

reconstruct "#section-1-onclick-links" -> UiDashboardPage {
  pageTitle: "Interactive Event Extraction & Security Sandbox";
  subTitle: "Tests extraction and handling of inline event handlers, string arithmetic, function calls, and data-attributes.";

  child cards {
    selector: ".test-case-card";
    bind title: "h3 | text";
    bind description: "p | text";
    bind url: "a.test-link | hrefOrOnclick";
    bind urlLabel: "a.test-link | text";
  }

  preserve {
    interactiveConsole: "#qa-log";
  }
}

reconstruct "#section-3-xss-sanitization" -> UiSearchBar {
  placeholder: "Test sanitization input...";
  queryParamName: "payload";
  submitUrl: "/sandbox-eval";

  bind defaultValue: "input#xss-input-1 | attr:value";
}

selector "header" -> UiNavHeader {
  action: replace;
  siteName: "Event Sandbox";
  logoUrl: "https://synthetic-events-portal.internal/assets/logo.png";
  primaryLinks: [
    { "label": "Onclick Links", "url": "/onclick" },
    { "label": "Dynamic Selectors", "url": "/selectors" },
    { "label": "XSS Tests", "url": "/xss" }
  ];
}

selector "#malformed-tag-container img[onerror]" {
  action: hide;
}
