{
    "components": [
        {
            "action": "hide",
            "selector": "#malformed-markup-section img[onerror], script"
        }
    ],
    "reconstructs": [
        {
            "children": [
                {
                    "name": "eventFeed",
                    "propsMap": {
                        "itemId": "self | attr:data-item-id",
                        "label": "a.action-link | text",
                        "metricValue": "span.metric-num | text | cleanNumber",
                        "tags": "span.item-tags | text | split",
                        "targetUrl": "a.action-link | hrefOrOnclick"
                    },
                    "selector": ".event-card-wrapper, .css-9x2a1b"
                }
            ],
            "containerSelector": "#events-root-container",
            "layoutComponent": "UiDashboardPage",
            "preserve": {
                "hiddenSecurityTokens": "#xss-form input[type='hidden']",
                "interactiveConsole": "#qa-log"
            },
            "props": {
                "pageTitle": "Interactive Event Extraction & Security Sandbox",
                "subtitle": "Testing dynamic selectors, inline onclick redirects, and XSS sanitization"
            }
        },
        {
            "children": [],
            "containerSelector": "#xss-form",
            "layoutComponent": "UiSearchBar",
            "preserve": {
                "hiddenInputs": "input[type='hidden']"
            },
            "props": {
                "placeholder": "Test sanitization input...",
                "queryParamName": "payload",
                "submitUrl": "/sandbox-eval"
            },
            "propsMap": {
                "defaultValue": "input[name='query'] | attr:value"
            }
        }
    ],
    "theme": {
        "cssVariables": {
            "--spm-accent": "#00e5ff",
            "--spm-bg-element": "#1e1e1e",
            "--spm-bg-primary": "#050505",
            "--spm-bg-surface": "#121212",
            "--spm-border-contrast": "rgba(0, 255, 102, 0.2)",
            "--spm-text-muted": "#888888",
            "--spm-text-primary": "#00ff66"
        },
        "customStyles": "#qa-log { font-family: monospace !important; border: 1px solid var(--spm-accent) !important; }",
        "label": "Event Sandbox Cyber"
    }
}
