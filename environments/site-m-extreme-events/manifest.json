{
    "components": [
        {
            "action": "replace",
            "name": "UiNavHeader",
            "props": {
                "logoUrl": "https://synthetic-events-portal.internal/assets/logo.png",
                "primaryLinks": [
                    {
                        "label": "Onclick Links",
                        "url": "/onclick"
                    },
                    {
                        "label": "Dynamic Selectors",
                        "url": "/selectors"
                    },
                    {
                        "label": "XSS Tests",
                        "url": "/xss"
                    }
                ],
                "siteName": "Event Sandbox"
            },
            "selector": "header"
        },
        {
            "action": "hide",
            "selector": "#malformed-tag-container img[onerror]"
        }
    ],
    "reconstructs": [
        {
            "children": [
                {
                    "name": "cards",
                    "propsMap": {
                        "description": "p | text",
                        "title": "h3 | text",
                        "url": "a.test-link | hrefOrOnclick",
                        "urlLabel": "a.test-link | text"
                    },
                    "selector": ".test-case-card"
                }
            ],
            "containerSelector": "#section-1-onclick-links",
            "layoutComponent": "UiDashboardPage",
            "preserve": {
                "interactiveConsole": "#qa-log"
            },
            "props": {
                "pageTitle": "Interactive Event Extraction & Security Sandbox",
                "subTitle": "Tests extraction and handling of inline event handlers, string arithmetic, function calls, and data-attributes."
            }
        },
        {
            "children": [],
            "containerSelector": "#section-3-xss-sanitization",
            "layoutComponent": "UiSearchBar",
            "props": {
                "placeholder": "Test sanitization input...",
                "queryParamName": "payload",
                "submitUrl": "/sandbox-eval"
            },
            "propsMap": {
                "defaultValue": "input#xss-input-1 | attr:value"
            }
        }
    ],
    "theme": {
        "cssVariables": {
            "--spm-accent": "#00e5ff",
            "--spm-bg-element": "#1e1e1e",
            "--spm-bg-primary": "#050505",
            "--spm-bg-surface": "#121212",
            "--spm-border-contrast": "rgba(0, 255, 102, 0.2)",
            "--spm-text-muted": "#888888",
            "--spm-text-primary": "#00ff66"
        },
        "customStyles": "#qa-log { font-family: monospace !important; border: 1px solid var(--spm-accent) !important; }",
        "label": "Event Sandbox Cyber"
    }
}
