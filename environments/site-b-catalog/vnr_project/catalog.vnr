class ProductCatalogItem {
  bind title: ".product-title | text";
  bind imageUrl: ".product-image img | attr:src";
  bind price: ".product-price | text";
  bind detailUrl: "a.product-link | attr:href";
}

reconstruct "#catalog-wrapper" -> UiSplitLayout {
  sidebarWidth: "280px";
  collapsible: true;

  primarySlot: "#main-grid";
  secondarySlot: "#filter-sidebar";
}

reconstruct ".hero-banner img" -> UiImageViewer {
  aspectRatio: "16:9";
  zoomable: true;
}
