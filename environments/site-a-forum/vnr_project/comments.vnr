class BaseCommentItem {
  bind postUser: "a.hnuser | text";
  bind postDate: "span.age | text";
}

class HNCommentItem extends BaseCommentItem {
  bind commentBody: "div.commtext | html";
}

reconstruct "table.comment-tree" -> UiCommentListPage {
  pageTitle: "Hacker News Discussion Thread";
  height: "calc(100vh - 80px)";

  child threads extends HNCommentItem {
    selector: "tr.athing.comtr";
  }

  preserve {
    replyForm: "form";
  }
}

selector ".obsolete-forum-footer" {
  action: hide;
}
