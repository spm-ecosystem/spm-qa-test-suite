// Safebooru.org Master Veneer Specification (.vnr)
// Generated by Parallel Subagent Orchestration

class ThumbCard {
    bind imageUrl: "img | attr:src";
    bind postUrl: "a | hrefOrOnclick";
    bind itemSelector: "self | selector";
}

class TagItem {
    bind tagName: "a | text";
    bind tagUrl: "a | attr:href";
    bind count: "span.tag-count | nextSiblingText | cleanNumber";
}

reconstruct "#header" -> UiNavHeader {
    action: replace;
    logoUrl: "#site-title a | hrefOrOnclick";
    pageTitle: "#site-title a | text";
}

reconstruct "#searchform" -> UiSearchBar {
    action: replace;
    submitUrl: "form | attr:action";
    hiddenFields: "form | hiddenInputs";
}

reconstruct "#grid-container" -> UiModernGridPage {
    child gridItems extends ThumbCard {
        selector: "span.thumb";
    }
}

reconstruct "#tag-sidebar" -> UiPostDetails {
    child tags extends TagItem {
        selector: "li";
    }
}
